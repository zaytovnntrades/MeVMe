# Copy to .env. Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- required ---
WEBHOOK_SECRET=
DASHBOARD_TOKEN=
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=

# --- Claude ---
ANTHROPIC_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium

# --- your account: Nasdaq futures, $25k, $1,000 prop-firm drawdown -----------------
ALLOWED_ASSET_CLASSES=["future"]
ALLOWED_FUTURES_ROOTS=["NQ", "MNQ"]
CONTRACT_SPECS_FILE=../config/nasdaq_futures.json   # docker-compose overrides this path
ACCOUNT_BALANCE=25000
RISK_PERCENT=1.0                 # 1% = $250 per trade
ALLOWED_RISK_PERCENTS=[0.5, 1.0, 2.0]
DRAWDOWN_LIMIT=1000              # total loss that fails the account
DRAWDOWN_MODE=static             # static (from starting balance) or trailing (from peak). Match your firm's rule.
MIN_REWARD_RISK=2.0              # TP1 must be at least 2R...
RR_TARGET_INDEX=1
TARGET_LADDER=[2, 3, 5]          # ...Claude aims TP1/TP2/TP3 near 2R/3R/5R
MAX_TARGET_R=5

# --- dashboard / network ---
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_API_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false
# TradingView's published webhook source IPs. Check TradingView's current list before enabling.
# TRADINGVIEW_IP_ALLOWLIST=["52.89.214.238", "34.212.75.30", "54.218.53.128", "52.32.178.7"]

# --- optional Telegram ---
TELEGRAM_BOT_TOKEN=https://discord.com/api/webhooks/1574830271998464115/zsUm49zybYCQK6RCVZNm9vtn7XZIsHlHstivLxUP2cQf02FOKJ_cg3GdfdbXLut2xiUR
TELEGRAM_CHAT_ID=
NOTIFY_DECISIONS=["LONG_SETUP", "SHORT_SETUP"]
