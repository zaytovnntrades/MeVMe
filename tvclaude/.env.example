# Copy to .env. Never commit .env. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- required ---
WEBHOOK_SECRET=
DASHBOARD_TOKEN=
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=

# --- Claude ---
ANTHROPIC_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium

# --- your account: MyFundedFutures Rapid 25K evaluation, NQ/MNQ only ---------------
ALLOWED_ASSET_CLASSES=["future"]
ALLOWED_FUTURES_ROOTS=["NQ", "MNQ"]
CONTRACT_SPECS_FILE=../config/nasdaq_futures.json   # docker-compose overrides this path
ACCOUNT_BALANCE=25000
RISK_PERCENT=1.0                 # 1% = $250 per trade
ALLOWED_RISK_PERCENTS=[0.5, 1.0, 2.0]
DRAWDOWN_LIMIT=1000              # total loss that fails the account
DRAWDOWN_MODE=eod_trailing       # static | trailing | eod_trailing. MFF evaluations: end-of-day trailing.
DRAWDOWN_LOCK_ABOVE_START=100    # floor stops at $25,100 (MFF help center, Builder 25K). CONFIRM for Rapid 25K.
ACCOUNT_PHASE=evaluation         # switch to funded after passing, and re-check the funded drawdown rule

# --- Shield ------------------------------------------------------------------------
DAILY_LOSS_LIMIT=500             # no new setups once one more full loss would pass -$500 today
MAX_CONSECUTIVE_LOSSES=2         # done for the day after 2 straight full losses
ENTRY_WINDOW=09:35-11:30         # New York time, Mon-Fri; alerts outside it are blocked before Claude
MIN_REWARD_RISK=2.0              # TP1 must be at least 2R...
RR_TARGET_INDEX=1
TARGET_LADDER=[2, 3, 5]          # ...Claude aims TP1/TP2/TP3 near 2R/3R/5R
MAX_TARGET_R=5

# --- dashboard / network ---
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_API_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false
# TradingView's published webhook source IPs. Check TradingView's current list before enabling.
# TRADINGVIEW_IP_ALLOWLIST=["52.89.214.238", "34.212.75.30", "54.218.53.128", "52.32.178.7"]

